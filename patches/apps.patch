+#
+# For a description of the syntax of this configuration file,
+# see the file kconfig-language.txt in the NuttX tools repository.
+#
+
+config EXAMPLES_TASKINFO_TEST
+	tristate "taskinfo() system call test"
+	default n
+	depends on SCHED_TASKINFO
+	---help---
+		Test application for the taskinfo() system call.
+
+if EXAMPLES_TASKINFO_TEST
+
+config EXAMPLES_TASKINFO_TEST_PROGNAME
+	string "Program name"
+	default "taskinfo_test"
+
+config EXAMPLES_TASKINFO_TEST_PRIORITY
+	int "Task priority"
+	default 100
+
+config EXAMPLES_TASKINFO_TEST_STACKSIZE
+	int "Stack size"
+	default 4096
+
+endif
