diff --git a/sched/task/task_info.c b/sched/task/task_info.c
new file mode 100644
index 0000000000..2435edc29c
--- /dev/null
+++ b/sched/task/task_info.c
@@ -0,0 +1,144 @@
+/****************************************************************************
+ * sched/task/task_info.c
+ *
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Licensed to the Apache Software Foundation (ASF) under one or more
+ * contributor license agreements.  See the NOTICE file distributed with
+ * this work for additional information regarding copyright ownership.  The
+ * ASF licenses this file to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance with the
+ * License.  You may obtain a copy of the License at
+ *
+ *   http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+ * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
+ * License for the specific language governing permissions and limitations
+ * under the License.
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <sys/types.h>
+#include <sys/taskinfo.h>
+#include <sched.h>
+#include <errno.h>
+#include <string.h>
+
+#include <nuttx/arch.h>
+#include <nuttx/irq.h>
+#include <nuttx/sched.h>
+
+#include "sched/sched.h"
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: taskinfo_policy
+ *
+ * Description:
+ *   Translate the scheduling policy bits of tcb->flags to SCHED_*.
+ *
+ ****************************************************************************/
+
+static uint8_t taskinfo_policy(FAR struct tcb_s *tcb)
+{
+  switch (tcb->flags & TCB_FLAG_POLICY_MASK)
+    {
+      case TCB_FLAG_SCHED_RR:
+        return SCHED_RR;
+
+      case TCB_FLAG_SCHED_SPORADIC:
+        return SCHED_SPORADIC;
+
+      case TCB_FLAG_SCHED_OTHER:
+        return SCHED_OTHER;
+
+      case TCB_FLAG_SCHED_FIFO:
+      default:
+        return SCHED_FIFO;
+    }
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: taskinfo
+ *
+ * Description:
+ *   Get a consistent snapshot of a task.  See include/sys/taskinfo.h.
+ *
+ * Input Parameters:
+ *   pid  - ID of the task to query; 0 means the calling task.
+ *   info - Location where the snapshot is returned.
+ *
+ * Returned Value:
+ *   0 on success; -1 with errno set to EINVAL or ESRCH on failure.
+ *
+ ****************************************************************************/
+
+int taskinfo(pid_t pid, FAR struct taskinfo_s *info)
+{
+  struct taskinfo_s snap;
+  FAR struct tcb_s *tcb;
+  irqstate_t flags;
+
+  if (info == NULL || pid < 0)
+    {
+      set_errno(EINVAL);
+      return ERROR;
+    }
+
+  /* The TCB can be deleted or change state at any time (on the other CPU
+   * too, if SMP).  A critical section is held from the lookup until
+   * everything is copied into a local structure: sched_lock() would not
+   * stop another CPU from deleting the task, while the critical section
+   * does.  nxsched_get_tcb() nests inside it.
+   */
+
+  flags = enter_critical_section();
+
+  tcb = (pid == 0) ? this_task() : nxsched_get_tcb(pid);
+  if (tcb == NULL)
+    {
+      leave_critical_section(flags);
+      set_errno(ESRCH);
+      return ERROR;
+    }
+
+  memset(&snap, 0, sizeof(snap));
+
+  snap.pid        = tcb->pid;
+  snap.state      = tcb->task_state;
+  snap.priority   = tcb->sched_priority;
+  snap.policy     = taskinfo_policy(tcb);
+  snap.stack_size = tcb->adj_stack_size;
+  snap.switches   = tcb->nswitches;
+
+#if CONFIG_TASK_NAME_SIZE > 0
+  strlcpy(snap.name, tcb->name, sizeof(snap.name));
+#endif
+
+#ifdef CONFIG_STACK_COLORATION
+  snap.stack_used = up_check_tcbstack(tcb, tcb->adj_stack_size);
+#endif
+
+  leave_critical_section(flags);
+
+  /* Deliver the result outside of the critical section */
+
+  *info = snap;
+  return OK;
+}
