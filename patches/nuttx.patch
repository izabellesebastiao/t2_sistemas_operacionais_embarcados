--- /dev/null
+++ b/include/sys/taskinfo.h
@@ -0,0 +1,94 @@
+/****************************************************************************
+ * include/sys/taskinfo.h
+ *
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Licensed to the Apache Software Foundation (ASF) under one or more
+ * contributor license agreements.  See the NOTICE file distributed with
+ * this work for additional information regarding copyright ownership.  The
+ * ASF licenses this file to you under the Apache License, Version 2.0 (the
+ * "License"); you may not use this file except in compliance with the
+ * License.  You may obtain a copy of the License at
+ *
+ *   http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+ * WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.  See the
+ * License for the specific language governing permissions and limitations
+ * under the License.
+ *
+ ****************************************************************************/
+
+#ifndef __INCLUDE_SYS_TASKINFO_H
+#define __INCLUDE_SYS_TASKINFO_H
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <sys/types.h>
+#include <stdint.h>
+
+/****************************************************************************
+ * Public Types
+ ****************************************************************************/
+
+/* Snapshot of a task, filled in by taskinfo().  All fields are read at the
+ * same instant, with the scheduler state frozen.
+ */
+
+struct taskinfo_s
+{
+  pid_t    pid;                             /* Task ID                       */
+  char     name[CONFIG_TASK_NAME_SIZE + 1]; /* Task name                     */
+  uint8_t  state;                           /* Task state (enum tstate_e,
+                                             * see nuttx/sched.h)            */
+  uint8_t  priority;                        /* Current priority              */
+  uint8_t  policy;                          /* SCHED_FIFO, SCHED_RR,
+                                             * SCHED_SPORADIC or
+                                             * SCHED_OTHER                   */
+  size_t   stack_size;                      /* Total stack size (bytes)      */
+  size_t   stack_used;                      /* Stack used, high-water mark
+                                             * (bytes); 0 unless
+                                             * CONFIG_STACK_COLORATION       */
+  uint32_t switches;                        /* Times the task was scheduled  */
+};
+
+/****************************************************************************
+ * Public Function Prototypes
+ ****************************************************************************/
+
+#ifdef __cplusplus
+extern "C"
+{
+#endif
+
+/****************************************************************************
+ * Name: taskinfo
+ *
+ * Description:
+ *   Get a consistent snapshot of a task.
+ *
+ * Input Parameters:
+ *   pid  - ID of the task to query; 0 means the calling task.
+ *   info - Location where the snapshot is returned.
+ *
+ * Returned Value:
+ *   0 on success.  On failure -1 is returned and errno is set:
+ *
+ *     EINVAL - info is NULL or pid is negative.
+ *     ESRCH  - There is no task with this pid.
+ *
+ ****************************************************************************/
+
+int taskinfo(pid_t pid, FAR struct taskinfo_s *info);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __INCLUDE_SYS_TASKINFO_H */
